# StillMe / ReVOICE -- copy to .env.local for local dev; set the same names in Vercel -> Settings -> Environment Variables.
# Every value below is SERVER-SIDE ONLY. Never prefix any of them with NEXT_PUBLIC_.

# ---- AssemblyAI (speech-to-text + text-to-speech, BYOK) ----
ASSEMBLYAI_API_KEY=
# Data zone: us | eu (cloned voices only work in the zone they were created in)
ASSEMBLYAI_REGION=us

# ---- Groq (three editable reply suggestions) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ---- LiveKit Cloud (partner-link / remote media + Python worker) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Signing / operations ----
# HMAC secret shared by the web app and the worker to sign approvals, invites and session tickets (32+ random bytes).
# Recommended. If empty, web + worker both derive it from LIVEKIT_API_SECRET (then ASSEMBLYAI_API_KEY).
REVOICE_APPROVAL_SECRET=
# Bearer secret Vercel Cron sends to /api/cron/purge (vercel.json schedules it daily).
CRON_SECRET=

# Browser-direct listening with a short-lived AssemblyAI token. Default ON so guests can listen with only ASSEMBLYAI_API_KEY.
REVOICE_ALLOW_BROWSER_STT=true

# ---- Optional ----
# Durable server-side store for budgets/usage (the browser never talks to Supabase). Without it, state is per-instance memory.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Operator-only: spend reconciliation + STT quota reset (sent as x-revoice-operator).
REVOICE_OPERATOR_TOKEN=
# Gate registering a cloned voice id on a public deployment (sent as x-revoice-clone-passcode).
REVOICE_CLONE_PASSCODE=
# Included US inbound number only; enable ONLY if activation needs no new spending.
REVOICE_PHONE_INBOUND_ENABLED=false
REVOICE_PHONE_NUMBER_DISPLAY=
