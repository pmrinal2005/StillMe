# ---- Server-side only. NEVER prefix these with NEXT_PUBLIC_. ----
ASSEMBLYAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# HMAC secret shared by the web app and the worker to sign approvals/invites/session tickets (32+ random bytes).
# Recommended. If empty, web + worker both derive it from LIVEKIT_API_SECRET (then ASSEMBLYAI_API_KEY).
REVOICE_APPROVAL_SECRET=
# AssemblyAI data zone: us | eu  (cloned voices only work in the zone they were created in)
ASSEMBLYAI_REGION=us
# Trusted private demo only: allow browser-direct temporary STT tokens
REVOICE_ALLOW_BROWSER_STT=false

# ---- Public (safe to ship to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
