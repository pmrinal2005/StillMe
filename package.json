{
  "name": "revoice",
  "version": "0.1.0",
  "private": true,
  "description": "ReVOICE \u2014 human-gated conversational voice prosthesis (assistive communication, not an autonomous agent)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "postbuild": "node scripts/scan-secrets.mjs",
    "smoke:live": "node scripts/live-smoke.mjs",
    "smoke:worker": "python3 worker/scripts/live_check.py"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "dexie": "^4.4.7",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
